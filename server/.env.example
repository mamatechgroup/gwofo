# ===================================================
# GWOFO Production Environment Configuration Template
# ===================================================

# Server Configuration
PORT=10000
NODE_ENV=production

# Database Configuration (PostgreSQL on Neon Serverless)
# Neon connection string with SSL required:
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origin (e.g. your production frontend or custom domain)
# Example: https://gwofo.org or https://gwofo.netlify.app
CORS_ORIGIN=https://gwofo.netlify.app

# Admin Credentials (Used for initial seed provisioning)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Authentication HMAC Secret (Optional custom secret for HMAC signing)
JWT_SECRET=super_secure_random_production_secret_key_change_me

# Automated Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Health Monitoring & Keep-Alive (External Service Integration)
# Use BetterStack or UptimeRobot to ping GET /health every 5 minutes:
# EXTERNAL_MONITOR_URL=https://gwofo.onrender.com/health

